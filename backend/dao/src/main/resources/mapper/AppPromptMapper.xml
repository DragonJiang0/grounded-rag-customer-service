<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zidong.dao.mapper.AppPromptMapper">

    <!--
      按 app_id 保存提示词：app_prompt.app_id 上必须存在唯一键（UNIQUE KEY uk_app_id）。
      命中唯一键冲突时覆盖 content / updated_at，一条 SQL 完成「无则插入、有则更新」，
      避免「先查再判断」在高并发下插入重复行。
      说明：MySQL 8.0.20 起 VALUES() 被标记为废弃但仍可用，
      如需去掉告警可换成 INSERT ... AS new ON DUPLICATE KEY UPDATE content = new.content。
    -->
    <insert id="saveOrUpdateByAppId">
        INSERT INTO app_prompt (app_id, content, created_at, updated_at)
        VALUES (#{prompt.appId}, #{prompt.content}, #{prompt.createdAt}, #{prompt.updatedAt})
        ON DUPLICATE KEY UPDATE content    = VALUES(content),
                                updated_at = VALUES(updated_at)
    </insert>
</mapper>
