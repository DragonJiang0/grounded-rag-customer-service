# ============================================================================
# 部署配置模板：`cp .env.example .env` 后按实际环境修改，结构与本机 .env 一致。
# docker compose 读取同目录 .env（文件名不要改）；变量全部由 compose 的 env_file 注入 portal 与 manage。
#
# 分三块：
#   1) 必填：MySQL、大模型、前端端口、库名
#   2) 有默认值：后端运行参数、laya 开关
#   3) 已废弃项说明
#
# 逐项说明见 deploy/CONFIG.md。
# ============================================================================

# ---------- 必填 1：MySQL 密码 ----------
# MySQL 镜像固定用官方 mysql:8.0（见 docker-compose.yml），不在此配置
# root 密码：后端直接用 root 账号连接，必须与这里一致
MYSQL_ROOT_PASSWORD=mysql_root

# ---------- 必填 2：大模型 ----------
# 容器内的 127.0.0.1 指向容器自身，访问不到宿主机服务，必须填容器可达地址：
#   - 宿主机内网 IP： http://172.16.1.200:8788
#   - 同网络其它容器：http://服务名:8788
LLM_BASE_URL=http://your-llm-host:8788
# 网关可选的模型名：deepseek-v4.1-flash / deepseek-v4-pro
LLM_MODEL=deepseek-v4.1-flash
# application.yaml 已移除内置默认 key，这里必须填，否则模型调用会失败
LLM_API_KEY=
# 是否打印模型请求/响应体；生产建议 false，排查时临时打开
LLM_LOG_ENABLED=false

# ---------- 必填 3：前端对外端口 ----------
# 只有一个前端容器映射主机端口：/apps/ 管理后台、/chat/ 聊天窗口
FRONT_HOST_PORT=8081

# ---------- 必填 4：MySQL 库名 ----------
# 与 mysql/init 里的建库名保持一致
MYSQL_DATABASE=server

# ---------- 后端运行参数（有默认值） ----------
# portal 与 manage 各一个 JVM，这条参数对两个容器分别生效
JAVA_OPTS="-Xms512m -Xmx1g"
LOG_LEVEL=info
# manage 调 portal 的 gRPC 超时（秒），默认 240，一般不用改
RPC_CLIENT_DEADLINE_SECONDS=240

# ---------- laya 决策模型（有默认值） ----------
# 开关：开启后多 Agent 选择走进程内 laya 决策模型，需把 JAVA_OPTS 的 -Xmx 调到 3g 以上
LAYA_ENABLED=false
# 模型目录：相对进程工作目录（容器内即 /app）。目录不存在时会按 fallback-model-source
# 自动下载到 ~/.cache/laya 再软链过来；网络受限时建议先把模型打进镜像，见 docs/04。
LAYA_MODEL_SOURCE=./models/laya-multilingual-mlx
# 以下三项仅「运行时自动下载模型」时需要（打进镜像的方式用不到），按需放开：
# 下载源镜像（默认 https://huggingface.co，网络不好换成 https://hf-mirror.com）
# HF_ENDPOINT=https://hf-mirror.com
# 下载鉴权令牌（仓库需要登录时才填）
# HF_TOKEN=
# 模型缓存根目录（默认 ~/.cache/laya）
# LAYA_CACHE=

# ============================================================================
# 说明
# ============================================================================

# mysql / JRE / Nginx 基础镜像都固定为官方镜像，写死在 docker-compose.yml
# 与 Dockerfile 里，不通过本文件配置；拉不到时由使用者自行处理网络或镜像源。

# ---------- 已废弃：portal / manage / mysql 不再映射主机端口 ----------
# 需要本机连库或调试后端时，临时在 docker-compose.yml 取消对应 ports 的注释
# MYSQL_HOST_PORT=3306
# MANAGE_HOST_PORT=8080
# PORTAL_HOST_PORT=9090
