# syntax=docker/dockerfile:1
# 前端运行镜像：托管 front（管理后台，/apps/）与 chatfront（聊天窗口，/chat/）两套产物。
# 构建上下文就是仓库根目录，产物目录按相对路径直接 COPY，不需要拼临时目录：
#   front/dist      -> /usr/share/nginx/html/apps/   （vite build --base=/apps/）
#   chatfront/dist  -> /usr/share/nginx/html/chat/   （npm run build -- --base=/chat/）
#
# 用法（在仓库根目录，两套 dist 已构建好）：
#   docker build -f deploy/Dockerfile.front -t front:latest .
# 基础镜像固定为官方镜像，不做任何配置；拉取不到时由使用者自行处理（代理/自建镜像仓库等）
FROM nginx:1.30.6-trixie-perl

# 同源反代：/manage/* -> manage:8080、/portal/* -> portal:9090
COPY deploy/nginx/front.conf /etc/nginx/conf.d/default.conf
COPY front/dist/ /usr/share/nginx/html/apps/
COPY chatfront/dist/ /usr/share/nginx/html/chat/

EXPOSE 80
